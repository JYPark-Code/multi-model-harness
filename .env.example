# copy .env.example .env 후 키를 채운다 — .env는 .gitignore에 등록돼 있어 커밋되지 않는다
# 기획·리뷰(GPT)용 — 필수
OPENAI_API_KEY=sk-...

# Claude 백엔드 (기본 cli — Claude Code 구독 인증, API 크레딧 불필요)
# HARNESS_CLAUDE_BACKEND=cli       # cli | api
# HARNESS_CLI_MODEL=               # cli 모드의 --model (빈 값 = CLI 기본 모델, 예: opus, sonnet)
# ANTHROPIC_API_KEY=sk-ant-...     # api 모드일 때만 필요

# 선택 오버라이드 (미설정 시 config.py 기본값)
# HARNESS_TARGET_REPO=C:\project\event-driven-commerce
# HARNESS_TEST_COMMAND=.\gradlew.bat test --console=plain
